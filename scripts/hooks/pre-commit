#!/bin/sh
# Local pre-commit hook: read-only lint gate mirroring PLM-012's CI checks.
# Activate with: git config core.hooksPath scripts/hooks

unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then
	echo "pre-commit: the following files are not gofmt-formatted:"
	echo "$unformatted"
	echo "pre-commit: run 'gofmt -w' on them and re-commit."
	exit 1
fi

vet_output=$(go vet ./... 2>&1)
vet_status=$?
if [ $vet_status -ne 0 ] || [ -n "$vet_output" ]; then
	echo "pre-commit: go vet ./... reported issues:"
	echo "$vet_output"
	exit 1
fi

exit 0
