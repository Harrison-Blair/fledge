# fledge broods: worktree_exists reporting and --stale filter
exec git init -q .

# a real directory on disk for the "live worktree" claim
mkdir livewt

# claim with --worktree pointing at an existing directory -> worktree_exists true
exec fledge brood FTHR-001 --owner adelie --worktree $WORK/livewt
# claim with --worktree pointing at a nonexistent path -> worktree_exists false
exec fledge brood FTHR-002 --owner gentoo --worktree $WORK/gonewt

# AC-2: broods --json reports worktree_exists per record
exec fledge broods --json
stdout '(?s)"feather": "FTHR-001".*?"worktree_exists": true'
stdout '(?s)"feather": "FTHR-002".*?"worktree_exists": false'
# legacy record (seeded FTHR-005, no worktree field) reports false
stdout '(?s)"feather": "FTHR-005".*?"worktree_exists": false'

# text output annotates the gone worktree, not the live one
exec fledge broods
stdout '(?m)^FTHR-002\s+gentoo\s+.*\(worktree gone\)$'
! stdout '(?m)^FTHR-001\b.*\(worktree gone\)'

# AC-3: --stale filters to worktree_exists:false records (json)
exec fledge broods --stale --json
! stdout '"feather": "FTHR-001"'
stdout '"feather": "FTHR-002"'
stdout '"feather": "FTHR-005"'

# AC-3: --stale filters to worktree_exists:false records (text)
exec fledge broods --stale
! stdout 'FTHR-001'
stdout 'FTHR-002'
stdout 'FTHR-005'

# plain broods (no flag) still returns the full set
exec fledge broods
stdout 'FTHR-001'
stdout 'FTHR-002'
stdout 'FTHR-005'

# FTHR-090 AC-4: no PID reporting anywhere in broods output
exec fledge broods --json
! stdout 'pid_alive'
exec fledge broods
! stdout 'pid not alive'

