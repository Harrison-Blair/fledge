# fledge nest status: the deterministic done-check the forager gates its final
# message on and the commissioner uses to tell a stall from a finished forager.
# Complete only when every concern doc is synthesized past its stub AND index.md
# is stamped to HEAD; exit 0 when complete, exit 1 when incomplete.
exec git init -q .
exec git -c user.email=t@t -c user.name=t commit --allow-empty -m init

exec fledge init

# Fresh scaffold: every doc is an untouched template stub -> incomplete (exit 1).
exec fledge nest scaffold
! exec fledge nest status
stdout 'nest incomplete'
stdout 'not synthesized'

# --json reports complete:false and lists all nine docs (8 concern + index) as stubs.
! exec fledge nest status --json
stdout '"complete": false'
stdout '"architecture"'
stdout '"domain"'
stdout '"index"'

# Fill every concern doc and the index past its stub (one generic body differs
# from every per-name stub), then re-stamp the index so its commit == HEAD.
cp filled.md .fledge/nest/architecture.md
cp filled.md .fledge/nest/modules.md
cp filled.md .fledge/nest/conventions.md
cp filled.md .fledge/nest/data-model.md
cp filled.md .fledge/nest/dependencies.md
cp filled.md .fledge/nest/entry-points.md
cp filled.md .fledge/nest/testing.md
cp filled.md .fledge/nest/domain.md
cp filled.md .fledge/nest/index.md
exec fledge nest stamp .fledge/nest/index.md

# A completed synthesis stamped to HEAD -> complete (exit 0).
exec fledge nest status
stdout 'nest complete'
exec fledge nest status --json
stdout '"complete": true'
stdout '"index_commit_matches": true'

# A concern doc left as its scaffold stub keeps the nest incomplete.
exec fledge nest new testing --force
! exec fledge nest status --json
stdout '"complete": false'
stdout '"stub_docs"'
stdout '"testing"'

# A missing concern doc is reported and keeps the nest incomplete.
rm .fledge/nest/domain.md
! exec fledge nest status --json
stdout '"complete": false'
stdout '"missing_docs"'
stdout '"domain"'

-- filled.md --
---
generated: 2026-01-01T00:00:00Z
commit: placeholder
agent: fledge-forager
fledge_version: 0.0.0
---

# Synthesized

Real synthesized content, not a template stub.
