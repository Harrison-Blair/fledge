# fledge lock/unlock/locks: claim files with auto-status
exec git init -q .

exec fledge lock TASK-001 --owner adelie
exists .fledge/locks/TASK-001.lock
grep 'status: in-progress' spec/tasks/TASK-001-first.md

# second claim fails and names the holder
! exec fledge lock TASK-001 --owner gentoo
stderr 'adelie'

# locks lists holders
exec fledge locks
stdout 'TASK-001'
stdout 'adelie'

# locked task is excluded from ready
exec fledge ready
stdout 'no ready tasks'

# unlock --done flips to done and releases
exec fledge unlock TASK-001 --done
grep 'status: done' spec/tasks/TASK-001-first.md
! exists .fledge/locks/TASK-001.lock

# with TASK-001 done, TASK-002 becomes ready
exec fledge ready
stdout 'TASK-002'

# unlock when not held fails, unless --force
! exec fledge unlock TASK-001
stderr 'not locked'
exec fledge unlock TASK-001 --force

# done task cannot be locked
! exec fledge lock TASK-001 --owner adelie
stderr 'done'

# unknown task cannot be locked
! exec fledge lock TASK-099 --owner adelie
stderr 'not found'

# unlock without --done leaves in-progress and warns
exec fledge lock TASK-002 --owner chinstrap
exec fledge unlock TASK-002
stderr 'in-progress'
grep 'status: in-progress' spec/tasks/TASK-002-second.md

-- .fledge/scan-ignore --
