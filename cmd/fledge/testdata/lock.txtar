# fledge brood/abandon/broods: claim files with auto-status
exec git init -q .

exec fledge brood FTHR-001 --owner adelie
exists .fledge/broods/FTHR-001.brood
grep 'status: hatching' .fledge/pluma/feathers/FTHR-001-first.md

# second claim fails and names the holder
! exec fledge brood FTHR-001 --owner gentoo
stderr 'adelie'

# broods lists holders
exec fledge broods
stdout 'FTHR-001'
stdout 'adelie'

# brooded feather is excluded from pipping
exec fledge ready
stdout 'no pipping feathers'

# abandon --fledged flips to fledged and releases
exec fledge abandon FTHR-001 --fledged
grep 'status: fledged' .fledge/pluma/feathers/FTHR-001-first.md
! exists .fledge/broods/FTHR-001.brood

# with FTHR-001 fledged, FTHR-002 becomes pipping
exec fledge ready
stdout 'FTHR-002'

# abandon when not held fails, unless --force
! exec fledge abandon FTHR-001
stderr 'not brooded'
exec fledge abandon FTHR-001 --force

# fledged feather cannot be brooded
! exec fledge brood FTHR-001 --owner adelie
stderr 'fledged'

# unknown feather cannot be brooded
! exec fledge brood FTHR-099 --owner adelie
stderr 'not found'

# abandon without --fledged leaves hatching and warns
exec fledge brood FTHR-002 --owner chinstrap
exec fledge abandon FTHR-002
stderr 'hatching'
grep 'status: hatching' .fledge/pluma/feathers/FTHR-002-second.md

# abandon --fledged refuses while acceptance criteria are unchecked
exec fledge brood FTHR-003 --owner emperor
! exec fledge abandon FTHR-003 --fledged
stderr 'AC-2'
exists .fledge/broods/FTHR-003.brood
grep 'status: hatching' .fledge/pluma/feathers/FTHR-003-gated.md

# --force bypasses the criteria gate
exec fledge abandon FTHR-003 --fledged --force
grep 'status: fledged' .fledge/pluma/feathers/FTHR-003-gated.md

# gate passes once every box is checked
exec fledge brood FTHR-004 --owner king
exec fledge criteria check FTHR-004 1
exec fledge abandon FTHR-004 --fledged
grep 'status: fledged' .fledge/pluma/feathers/FTHR-004-gated2.md

-- .fledge/.gitkeep --
