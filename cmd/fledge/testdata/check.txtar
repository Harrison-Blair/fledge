# fledge check: clean set passes, broken set fails with findings
exec git init -q .

exec fledge check
stdout 'spec clean: 1 requirements, 2 tasks'

exec fledge check --json
stdout '"ok": true'

# introduce a dangling dep + draft requirement reference
cp bad/TASK-003-bad.md spec/tasks/TASK-003-bad.md
! exec fledge check
stdout 'ERROR spec/tasks/TASK-003-bad.md: requirement REQ-099 does not exist'
stdout 'ERROR spec/tasks/TASK-003-bad.md: depends_on references unknown TASK-098'
stdout 'ERROR spec/tasks/TASK-003-bad.md: missing or empty "## Tests" section'

! exec fledge check --json
stdout '"ok": false'

# strict promotes warnings: stale ready hint on TASK-002
rm spec/tasks/TASK-003-bad.md
exec fledge check
exec fledge check --strict

-- .fledge/scan-ignore --
