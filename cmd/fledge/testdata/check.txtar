# fledge preen: clean set passes, broken set fails with findings
exec git init -q .

exec fledge preen
stdout 'spec clean: 1 plumages, 2 feathers'

exec fledge preen --json
stdout '"ok": true'

# introduce a dangling dep + egg plumage reference
cp bad/FTHR-003-bad.md .fledge/pluma/feathers/FTHR-003-bad.md
! exec fledge preen
stdout 'ERROR .fledge/pluma/feathers/FTHR-003-bad.md: plumage PLM-099 does not exist'
stdout 'ERROR .fledge/pluma/feathers/FTHR-003-bad.md: depends_on references unknown FTHR-098'
stdout 'ERROR .fledge/pluma/feathers/FTHR-003-bad.md: missing or empty "## Tests" section'

! exec fledge preen --json
stdout '"ok": false'

rm .fledge/pluma/feathers/FTHR-003-bad.md

# fledged feather with unchecked criteria is an error
cp bad/FTHR-004-done-unchecked.md .fledge/pluma/feathers/FTHR-004-done-unchecked.md
! exec fledge preen
stdout 'ERROR .fledge/pluma/feathers/FTHR-004-done-unchecked.md: fledged but acceptance criteria unchecked: AC-2'
rm .fledge/pluma/feathers/FTHR-004-done-unchecked.md

# checked criteria warn without a matching evidence section
cp bad/FTHR-005-no-evidence.md .fledge/pluma/feathers/FTHR-005-no-evidence.md
exec fledge preen
stdout 'FTHR-005.md is missing'
mkdir .fledge/molt
cp evidence/FTHR-005.md .fledge/molt/FTHR-005.md
exec fledge preen
! stdout 'FTHR-005.md is missing'
! stdout 'missing evidence sections'
rm .fledge/pluma/feathers/FTHR-005-no-evidence.md

# clean again, including under --strict
exec fledge preen
exec fledge preen --strict

-- .fledge/.gitkeep --
