# fledge check: clean set passes, broken set fails with findings
exec git init -q .

exec fledge check
stdout 'spec clean: 1 requirements, 2 tasks'

exec fledge check --json
stdout '"ok": true'

# introduce a dangling dep + draft requirement reference
cp bad/TASK-003-bad.md spec/tasks/TASK-003-bad.md
! exec fledge check
stdout 'ERROR spec/tasks/TASK-003-bad.md: requirement REQ-099 does not exist'
stdout 'ERROR spec/tasks/TASK-003-bad.md: depends_on references unknown TASK-098'
stdout 'ERROR spec/tasks/TASK-003-bad.md: missing or empty "## Tests" section'

! exec fledge check --json
stdout '"ok": false'

rm spec/tasks/TASK-003-bad.md

# done task with unchecked criteria is an error
cp bad/TASK-004-done-unchecked.md spec/tasks/TASK-004-done-unchecked.md
! exec fledge check
stdout 'ERROR spec/tasks/TASK-004-done-unchecked.md: done but acceptance criteria unchecked: AC-2'
rm spec/tasks/TASK-004-done-unchecked.md

# checked criteria warn without a matching evidence section
cp bad/TASK-005-no-evidence.md spec/tasks/TASK-005-no-evidence.md
exec fledge check
stdout 'TASK-005.md is missing'
mkdir .fledge/evidence
cp evidence/TASK-005.md .fledge/evidence/TASK-005.md
exec fledge check
! stdout 'TASK-005.md is missing'
! stdout 'missing evidence sections'
rm spec/tasks/TASK-005-no-evidence.md

# clean again, including under --strict
exec fledge check
exec fledge check --strict

-- .fledge/scan-ignore --
