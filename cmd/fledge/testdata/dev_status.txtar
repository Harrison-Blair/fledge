# fledge dev status: reports dev-link state and broken links (FTHR-079)

# not dev-linked reports plainly, after a normal fledge init (AC-2)
mkdir repo
cd repo
exec git init -q .
exec fledge init
exec fledge dev status
stdout 'not dev-linked'
cd ..

# no stamp at all is not an error (AC-2): a repo with no .fledge/scaffold.json,
# because fledge init never ran, still exits zero and reports not dev-linked.
mkdir bare
cd bare
exec git init -q .
exec fledge dev status
stdout 'not dev-linked'
cd ..

# dev-linked reports source and count (AC-3, PLM-031 AC-8)
mkdir linked
cd linked
exec git init -q .
exec fledge init --dev=$WORK/src
exec fledge dev status
stdout 'dev-linked'
stdout 'source=.*/src'
stdout 'files=[0-9]+'
! stdout 'broken links'

# broken link is detected and named (AC-4, PLM-031 AC-9): delete one file
# from the fake source, then dev status must exit non-zero and name it.
rm $WORK/src/internal/bootstrap/core/skills/fledge-orchestrate/SKILL.md
! exec fledge dev status
stdout '.fledge/skills/fledge-orchestrate/SKILL.md'

# a moved source reports every broken link, not just the first (AC-4): rename
# the whole fake source directory so every dev-linked path dangles at once.
mv $WORK/src $WORK/src-moved
! exec fledge dev status
stdout '.fledge/skills/fledge-orchestrate/SKILL.md'
stdout '.claude/agents/fledge-brooder.md'
mv $WORK/src-moved $WORK/src
cd ..

# --json emits the documented shape (AC-5)
cp $WORK/updated-skill.md $WORK/src/internal/bootstrap/core/skills/fledge-orchestrate/SKILL.md
mkdir jsonrepo
cd jsonrepo
exec git init -q .
exec fledge init --dev=$WORK/src
exec fledge dev status --json
stdout '"linked": true'
stdout '"source": '
stdout '"count": [0-9]+'
stdout '"broken": \[\]'
cd ..

