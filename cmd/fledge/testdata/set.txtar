# fledge set: frontmatter field updates with validation
exec git init -q .

exec fledge set TASK-002 priority P0
grep 'priority: P0' spec/tasks/TASK-002-second.md
! exec fledge set TASK-002 priority P7
stderr 'not one of'

exec fledge set TASK-002 oversight during
grep 'oversight: during' spec/tasks/TASK-002-second.md
exec fledge set TASK-002 oversight none
! grep 'oversight' spec/tasks/TASK-002-second.md

# depends_on validates refs and acyclicity
exec fledge set TASK-002 depends_on TASK-001
grep 'depends_on: \[TASK-001\]' spec/tasks/TASK-002-second.md
! exec fledge set TASK-002 depends_on TASK-099
stderr 'TASK-099'
! exec fledge set TASK-001 depends_on TASK-002
stderr 'cycle'

# clearing depends_on
exec fledge set TASK-002 depends_on none
grep 'depends_on: \[\]' spec/tasks/TASK-002-second.md

# title updates frontmatter and heading, warns about filename
exec fledge set TASK-002 title 'Renamed task'
grep 'title: Renamed task' spec/tasks/TASK-002-second.md
grep '# TASK-002: Renamed task' spec/tasks/TASK-002-second.md
stderr 'filename'

# immutable fields are refused
! exec fledge set TASK-002 id TASK-009
stderr 'cannot set'
! exec fledge set TASK-002 status done
stderr 'fledge status'

-- .fledge/scan-ignore --
