# fledge set: frontmatter field updates with validation
exec git init -q .

exec fledge set FTHR-002 priority P0
grep 'priority: P0' pluma/feathers/FTHR-002-second.md
! exec fledge set FTHR-002 priority P7
stderr 'not one of'

exec fledge set FTHR-002 oversight during
grep 'oversight: during' pluma/feathers/FTHR-002-second.md
exec fledge set FTHR-002 oversight none
! grep 'oversight' pluma/feathers/FTHR-002-second.md

# depends_on validates refs and acyclicity
exec fledge set FTHR-002 depends_on FTHR-001
grep 'depends_on: \[FTHR-001\]' pluma/feathers/FTHR-002-second.md
! exec fledge set FTHR-002 depends_on FTHR-099
stderr 'FTHR-099'
! exec fledge set FTHR-001 depends_on FTHR-002
stderr 'cycle'

# clearing depends_on
exec fledge set FTHR-002 depends_on none
grep 'depends_on: \[\]' pluma/feathers/FTHR-002-second.md

# title updates frontmatter and heading, warns about filename
exec fledge set FTHR-002 title 'Renamed task'
grep 'title: Renamed task' pluma/feathers/FTHR-002-second.md
grep '# FTHR-002: Renamed task' pluma/feathers/FTHR-002-second.md
stderr 'filename'

# immutable fields are refused
! exec fledge set FTHR-002 id FTHR-009
stderr 'cannot set'
! exec fledge set FTHR-002 status done
stderr 'fledge status'

-- .fledge/.gitkeep --
-- pluma/plumage/PLM-001-a.md --
