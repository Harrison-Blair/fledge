# multi-agent init: --list-agents, auto-detect, --agent, --refresh,
# duplicate guard, --json agents field

# --list-agents enumerates adapters and derived tiers; works outside a repo
exec fledge init --list-agents
stdout 'claude\ttier C'
stdout 'codex\ttier A'
stdout 'pi\ttier A'

# auto-detect: a .pi/ marker scaffolds only the pi adapter
mkdir pi-repo
cd pi-repo
exec git init -q .
mkdir .pi
exec fledge init
stdout 'scaffolded agents: pi'
! stdout 'claude'
exists .pi/settings.json
exists .pi/prompts/fledge-plan.md
exists .pi/prompts/fledge-implement.md
exists .pi/fledge-adapter.md
exists .fledge/skills/fledge-orchestrate/SKILL.md
! exists .claude
exists .fledge/scaffold.json
grep '"pi"' .fledge/scaffold.json

# auto-detect: both markers scaffold both adapters
cd $WORK
mkdir both-repo
cd both-repo
exec git init -q .
mkdir .claude .pi
exec fledge init
stdout 'scaffolded agents: claude, pi'
exists .claude/fledge-adapter.md
exists .pi/fledge-adapter.md

# --agent overrides detection; re-running with another agent is additive
cd $WORK
mkdir agent-repo
cd agent-repo
exec git init -q .
exec fledge init --agent claude,pi
stdout 'scaffolded agents: claude, pi'
exists .claude/fledge-adapter.md
exists .pi/fledge-adapter.md

exec fledge init --agent codex
stdout 'scaffolded agents: codex'
exists .codex/fledge-adapter.md
grep 'fledge-orchestrate/SKILL.md' AGENTS.md
exists .claude/fledge-adapter.md
exists .pi/fledge-adapter.md
exists .fledge/scaffold.json
grep '"codex"' .fledge/scaffold.json
grep '"claude"' .fledge/scaffold.json
grep '"pi"' .fledge/scaffold.json

# the AGENTS.md pointer line is appended once, never duplicated
exec fledge init --agent codex
grep -count=1 'fledge-orchestrate/SKILL.md' AGENTS.md

# the Claude CLAUDE.md pointer: created when absent, exact wording, idempotent
cd $WORK
mkdir claude-pointer-repo
cd claude-pointer-repo
exec git init -q .
! exists CLAUDE.md
exec fledge init --agent claude
stdout 'scaffolded agents: claude'
exists CLAUDE.md
grep 'fledge-orchestrate/SKILL.md' CLAUDE.md
# exact pointer line, differing from the Codex line only in the adapter path
grep '> fledge: load and follow .fledge/skills/fledge-orchestrate/SKILL.md — primitive map at .claude/fledge-adapter.md' CLAUDE.md
# re-running appends the line once, never duplicated
exec fledge init --agent claude
grep -count=1 'fledge-orchestrate/SKILL.md' CLAUDE.md

# an existing CLAUDE.md is preserved; the pointer is appended additively
cd $WORK
mkdir claude-existing-repo
cd claude-existing-repo
exec git init -q .
cp $WORK/seed-claude.md CLAUDE.md
exec fledge init --agent claude
grep 'my existing claude prose' CLAUDE.md
grep 'fledge-orchestrate/SKILL.md' CLAUDE.md

# unknown agent → usage error pointing at --list-agents
! exec fledge init --agent nope
stderr 'unknown agent "nope"'
stderr 'list-agents'

# --refresh: default-policy files the user has edited are preserved and
# reported ("kept … use --force"); --refresh --force restores them to the
# shipped version (with a stderr note); a second refresh with no edits is silent.
cd $WORK
mkdir core-repo
cd core-repo
exec git init -q .
mkdir .claude
exec fledge init
grep 'fledge nest scaffold' .claude/agents/fledge-forager.md
grep 'fledge nest scout --module' .claude/agents/fledge-context-scout.md
grep 'mutates no spec' .claude/agents/fledge-incubator.md
cp $WORK/custom-skill.md .fledge/skills/fledge-orchestrate/SKILL.md
cp $WORK/custom-skill.md .claude/agents/fledge-brooder.md
exec fledge init
grep 'my local edit' .fledge/skills/fledge-orchestrate/SKILL.md
grep 'my local edit' .claude/agents/fledge-brooder.md
exec fledge init --refresh
! stderr 'refreshed'
stdout 'kept .fledge/skills/fledge-orchestrate/SKILL.md \(user-edited; use --force\)'
stdout 'kept .claude/agents/fledge-brooder.md \(user-edited; use --force\)'
grep 'my local edit' .fledge/skills/fledge-orchestrate/SKILL.md
grep 'my local edit' .claude/agents/fledge-brooder.md
exec fledge init --refresh --force
stderr 'refreshed'
stdout 'updated .fledge/skills/fledge-orchestrate/SKILL.md'
stdout 'updated .claude/agents/fledge-brooder.md'
! grep 'my local edit' .fledge/skills/fledge-orchestrate/SKILL.md
! grep 'my local edit' .claude/agents/fledge-brooder.md
grep 'fledge nest scaffold' .claude/agents/fledge-forager.md
grep 'fledge nest scout --module' .claude/agents/fledge-context-scout.md
grep 'mutates no spec' .claude/agents/fledge-incubator.md
exec fledge init --refresh
! stdout 'updated'
! stderr 'refreshed'

# duplicate guard: a same-name skill in a harness-native skills dir refuses init
cd $WORK
mkdir dup-repo
cd dup-repo
exec git init -q .
mkdir .claude/skills/fledge-orchestrate
cp $WORK/custom-skill.md .claude/skills/fledge-orchestrate/SKILL.md
! exec fledge init
stderr 'duplicate skill'
stderr 'MIGRATION.md'
! exists .fledge/skills/fledge-orchestrate/SKILL.md

# --json reports which adapters were scaffolded
cd $WORK
mkdir json-repo
cd json-repo
exec git init -q .
exec fledge init --agent pi --json
stdout '"agents": \['
stdout '"pi"'
! stdout '"claude"'

-- custom-skill.md --
my local edit
-- seed-claude.md --
# Project notes
my existing claude prose
