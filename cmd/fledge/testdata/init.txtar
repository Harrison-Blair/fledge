# fledge init: idempotent scaffolding
exec git init -q .

exec fledge init
stdout 'created .fledge/nest/raw/.gitkeep'
stdout 'created .fledge/broods/.gitkeep'
stdout 'created .fledgeignore'
stdout 'created pluma/plumage/.gitkeep'
stdout 'created pluma/feathers/.gitkeep'
stdout 'created .gitignore'
stdout 'created .fledge/skills/fledge-orchestrate/SKILL.md'
stdout 'created .fledge/skills/fledge-interrogate/SKILL.md'
stdout 'created .claude/agents/fledge-brooder.md'
stdout 'created .claude/agents/fledge-incubator.md'
stdout 'created .claude/fledge-adapter.md'
stdout 'scaffolded agents: claude'
stderr 'no agent harness detected; scaffolded the claude adapter by default'
exists .fledgeignore
exists .claude/agents/fledge-brooder.md
exists .claude/agents/fledge-incubator.md
exists .claude/settings.local.json
exists .claude/team-loop.md
exists .fledge/skills/fledge-orchestrate/templates/plumage.md
exists .claude/skills/fledge-orchestrate/SKILL.md
exists .claude/skills/fledge-interrogate/SKILL.md
grep '.fledge/nest/raw/' .gitignore
grep '.fledge/broods/' .gitignore
grep 'fledge nest' .claude/settings.local.json
grep 'fledge nest scaffold' .claude/agents/fledge-forager.md
grep 'fledge nest scout --module' .claude/agents/fledge-context-scout.md
grep 'owns the planning phase end to end' .claude/agents/fledge-incubator.md
stdout 'created .fledge/scaffold.json'
exists .fledge/scaffold.json
grep '"fledgeVersion"' .fledge/scaffold.json
grep '".fledge/skills/fledge-orchestrate/SKILL.md"' .fledge/scaffold.json
grep '".claude/fledge-adapter.md"' .fledge/scaffold.json
grep '"claude"' .fledge/scaffold.json

# second run is fully quiet: creates nothing, and byte-identical files
# (including generated ones) report exists, not updated
exec fledge init
stdout 'exists .fledgeignore'
! stdout 'created'
! stdout 'updated'
stdout 'exists .claude/fledge-adapter.md'
stdout 'exists .fledge/skills/fledge-orchestrate/SKILL.md'
stdout 'exists .fledge/scaffold.json'
grep -count=1 '.fledge/broods/' .gitignore

# the scaffold is immediately usable
exec fledge preen
stdout 'spec clean: 0 plumages, 0 feathers'

exec fledge init --json
stdout '"created": \[\]'
stdout '"agents": \['
stdout '"claude"'
