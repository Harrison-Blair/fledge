# fledge init: idempotent scaffolding
exec git init -q .

exec fledge init
stdout 'created .fledge/nest/raw/.gitkeep'
stdout 'created .fledge/broods/.gitkeep'
stdout 'created .fledgeignore'
stdout 'created .fledge/pluma/plumage/.gitkeep'
stdout 'created .fledge/pluma/feathers/.gitkeep'
stdout 'created .gitignore'
stdout 'created .fledge/skills/fledge-orchestrate/SKILL.md'
stdout 'created .fledge/skills/fledge-interrogate/SKILL.md'
stdout 'created .claude/agents/fledge-brooder.md'
stdout 'created .claude/agents/fledge-incubator.md'
stdout 'created .claude/fledge-adapter.md'
stdout 'scaffolded agents: claude'
stderr 'no agent harness detected; scaffolded the claude adapter by default'
exists .fledgeignore
exists .claude/agents/fledge-brooder.md
exists .claude/agents/fledge-incubator.md
exists .claude/settings.local.json
exists .claude/team-loop.md
exists .fledge/skills/fledge-orchestrate/templates/plumage.md
exists .claude/skills/fledge-orchestrate/SKILL.md
exists .claude/skills/fledge-interrogate/SKILL.md
grep '.fledge/nest/raw/' .gitignore
grep '.fledge/broods/' .gitignore
grep '.alloc.lock' .gitignore
grep 'fledge nest' .claude/settings.local.json
grep 'Bash\(fledge update \*\)' .claude/settings.local.json
grep 'Bash\(fledge roster \*\)' .claude/settings.local.json
grep 'fledge nest scaffold' .claude/agents/fledge-forager.md
grep 'fledge nest scout --module' .claude/agents/fledge-context-scout.md
grep 'owns the planning phase end to end' .claude/agents/fledge-incubator.md
stdout 'created .fledge/scaffold.json'
exists .fledge/scaffold.json
grep '"fledgeVersion"' .fledge/scaffold.json
grep '".fledge/skills/fledge-orchestrate/SKILL.md"' .fledge/scaffold.json
grep '".claude/fledge-adapter.md"' .fledge/scaffold.json
grep '"claude"' .fledge/scaffold.json

# a bare .alloc.lock pattern must be honored at any allocation-directory depth
# (runs an exec, so it comes after the fledge-init stdout assertions above)
exec git check-ignore .fledge/pluma/plumage/.alloc.lock .fledge/pluma/feathers/.alloc.lock

# second run is fully quiet: creates nothing, and byte-identical files
# (including generated ones) report exists, not updated
exec fledge init
stdout 'exists .fledgeignore'
! stdout 'created'
! stdout 'updated'
stdout 'exists .claude/fledge-adapter.md'
stdout 'exists .fledge/skills/fledge-orchestrate/SKILL.md'
stdout 'exists .fledge/scaffold.json'
grep -count=1 '.fledge/broods/' .gitignore

# the scaffold is immediately usable
exec fledge preen
stdout 'spec clean: 0 plumages, 0 feathers'

exec fledge init --json
stdout '"created": \[\]'
stdout '"agents": \['
stdout '"claude"'

# team-loop.md "Shutting down teammates" generalized to all four teammate
# roles (FTHR-041 AC-5), and its confirmed-shutdown definition handles the
# no-tmux/degraded case where no pane was ever created (FTHR-041 AC-6)
grep 'all four teammate roles — brooder, skua, forager, incubator' .claude/team-loop.md
! grep 'do this for the brooder \*and\* its paired skua at green teardown' .claude/team-loop.md
grep 'roster absence alone suffices there' .claude/team-loop.md
! grep 'the teammate no longer appears in the team roster and its tmux pane has closed' .claude/team-loop.md

# spawn name bound to the full role-species prefix (FTHR-042): the spawn
# tool's `name` argument must be the complete `fledge-<role>-<species>`
# string, not the bare species (AC-2), the old ambiguous phrasing is gone
# (AC-2), the planning-delegation callouts cross-reference the binding
# (AC-3), and a post-spawn roster self-check is present (AC-4)
grep 'must be the complete `fledge-<role>-<species>` string' .claude/team-loop.md
grep 'name: "fledge-brooder-adelie"' .claude/team-loop.md
grep 'never just `name: "adelie"`' .claude/team-loop.md
! grep 'named per the penguin-species scheme in `implementation.md` §3.1.' .claude/team-loop.md
grep 'already pass the complete `fledge-incubator-<species>`/`fledge-forager-<species>` string' .claude/team-loop.md
grep 'consistent with the binding in' .claude/team-loop.md
grep 'appears in the team roster under that exact full name before proceeding' .claude/team-loop.md

# plumage closeout queries `fledge colony --json` for the last-feather
# decision instead of the orchestrator mentally tracking it (FTHR-047): both
# the solo (§2) and team (§3) closeout steps instruct running it, and the old
# "if that was the last unfinished feather" mental-tracking phrasing is gone
grep -count=2 'fledge colony --json' .fledge/skills/fledge-orchestrate/implementation.md
! grep 'last unfinished feather' .fledge/skills/fledge-orchestrate/implementation.md

# roster wiring (FTHR-055): implementation.md drives species allocation (§3.1),
# release (§3.2), and resume reconstruction (§6) through the `fledge roster` CLI
# instead of orchestrator-context bookkeeping, referencing internal/roster's
# species list by package name rather than an unenumerated count (PLM-026 FC-5)
grep 'fledge roster assign --feather FTHR-### --pair' .fledge/skills/fledge-orchestrate/implementation.md
grep 'without `--pair`' .fledge/skills/fledge-orchestrate/implementation.md
grep 'internal/roster' .fledge/skills/fledge-orchestrate/implementation.md
grep 'fledge roster release <name>' .fledge/skills/fledge-orchestrate/implementation.md
grep 'to read the current name' .fledge/skills/fledge-orchestrate/implementation.md
! grep '18 extant penguin species' .fledge/skills/fledge-orchestrate/implementation.md
! grep 'mapping internally' .fledge/skills/fledge-orchestrate/implementation.md
! grep 'clear the roster' .fledge/skills/fledge-orchestrate/implementation.md

# recovery-step rewrite (FTHR-052): §6 step 2 classifies stale locks via
# `fledge broods --stale` directly instead of hand-correlating `git worktree
# list` against `fledge broods`, resumes on `worktree_exists: true`, and states
# the legacy empty-worktree-path re-check caveat (PLM-025 FC-4, AC-4). The old
# hand-correlation phrasing is gone; `git worktree list` survives only as the
# tool for the manual legacy re-check.
grep 'fledge broods --stale' .fledge/skills/fledge-orchestrate/implementation.md
grep 'worktree_exists: true' .fledge/skills/fledge-orchestrate/implementation.md
grep 'before force-releasing' .fledge/skills/fledge-orchestrate/implementation.md
grep 'predates FTHR-050' .fledge/skills/fledge-orchestrate/implementation.md
grep 'git worktree list' .fledge/skills/fledge-orchestrate/implementation.md
! grep 'has no surviving worktree are stale' .fledge/skills/fledge-orchestrate/implementation.md
