# End-to-end fledge lifecycle: init → new → approve → feathers → preen →
# vee → brood → abandon --fledged → pipping unlocks the dependent feather.
exec git init -q .
exec fledge init

exec fledge new plumage --title 'Build the widget'
exec fledge status PLM-001 hatched
exec fledge new feather --title 'Lay foundation' --plumage PLM-001
exec fledge new feather --title 'Assemble widget' --plumage PLM-001 --depends-on FTHR-001
exec fledge new feather --title 'Polish widget' --plumage PLM-001 --depends-on FTHR-002 --oversight merge

exec fledge preen
stdout 'spec clean: 1 plumages, 3 feathers'

exec fledge vee
stdout 'wave 1: FTHR-001'
stdout 'wave 2: FTHR-002'
stdout 'wave 3: FTHR-003'

exec fledge ready
stdout 'FTHR-001'
! stdout 'FTHR-002'

# dispatch FTHR-001
exec fledge brood FTHR-001 --owner adelie --branch task/FTHR-001-lay-foundation
exec fledge ready
stdout 'no pipping feathers'
exec fledge broods
stdout 'adelie'

# completion is gated: new-task templates emit unchecked AC boxes
! exec fledge abandon FTHR-001 --fledged
stderr 'unchecked'
exec fledge criteria FTHR-001
stdout '\[ \] AC-1:'

# verify criteria (with evidence) and complete; the dependent becomes pipping
exec fledge criteria check FTHR-001 1
exec fledge criteria check FTHR-001 2
mkdir .fledge/molt
cp evidence/FTHR-001.md .fledge/molt/FTHR-001.md
exec fledge abandon FTHR-001 --fledged
exec fledge ready
stdout 'FTHR-002'
! stdout 'FTHR-003'

# vee reflects the fledged state
exec fledge vee
stdout 'wave 1: FTHR-001 \[fledged\]'

# spec still clean after all rewrites
exec fledge preen
stdout 'spec clean'
-- evidence/FTHR-001.md --
# Evidence: FTHR-001 — Lay foundation

## AC-1
Commands: `go test ./...`
Captured failing-then-passing output.

## AC-2
Claim and supporting output.
