# fledge ready: recomputed from deps; done unlocks dependents; locks exclude
exec git init -q .

# TASK-001 is done, so TASK-002 (deps: TASK-001) is ready despite status: blocked
exec fledge ready
stdout 'TASK-002  P1  Second  \(req REQ-001\)'
! stdout 'TASK-003'

exec fledge ready --json
stdout '"id": "TASK-002"'

# a held lock excludes the task from the ready set
mkdir .fledge/locks
cp lock.json .fledge/locks/TASK-002.lock
exec fledge ready
stdout 'no ready tasks'

-- lock.json --
