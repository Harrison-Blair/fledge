# fledge pipping: recomputed from deps; fledged unlocks dependents; broods exclude
exec git init -q .

# FTHR-001 is fledged, so FTHR-002 (deps: FTHR-001) is pipping despite status: egg
exec fledge ready
stdout 'FTHR-002  P1  Second  \(plumage PLM-001\)'
! stdout 'FTHR-003'

exec fledge ready --json
stdout '"id": "FTHR-002"'

# a held brood excludes the feather from the pipping set
mkdir .fledge/broods
cp lock.json .fledge/broods/FTHR-002.brood
exec fledge ready
stdout 'no pipping feathers'

-- lock.json --
