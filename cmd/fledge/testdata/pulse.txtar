# fledge pulse: liveness report for a named worker, reachable from prose
exec git init -q .

# happy path: a fresh heartbeat reports not stalled
exec fledge heartbeat watcher-subject --note 'now running'
exec fledge pulse watcher-subject
stdout 'stalled=false'

# --json reports stalled, reason, the declared period, and elapsed time
exec fledge pulse watcher-subject --json
stdout '"name": "watcher-subject"'
stdout '"stalled": false'
stdout '"reason": "'
stdout '"expect": "5m0s"'
stdout '"elapsed": "'

# a worker with no status record at all is a distinct third state: not
# stalled, with a reason naming the absence, and exit 0 (not ExitFail)
exec fledge pulse nobody-yet --json
stdout '"stalled": false'
stdout '"reason": "no status record'

# a lease aged well past the old 5-minute threshold, but with a declared
# period far larger, reports NOT stalled — the behavior PLM-035 makes
# possible. Aged deterministically via a back-dated updated_at written
# directly into the ledger, never by sleeping.
cp aged-not-stalled.json .fledge/ledger/long-runner.status.json
exec fledge pulse long-runner --json
stdout '"stalled": false'
stdout '"expect": "438000h"'

# a lease aged past its own declared (default) period reports stalled — and
# still exits 0: the classification rides in the output, not the exit code
cp aged-stalled.json .fledge/ledger/gone-quiet.status.json
exec fledge pulse gone-quiet --json
stdout '"stalled": true'
exec sh -c 'fledge pulse gone-quiet --json; test $? -eq 0'

# malformed input: missing <name> is a usage error (exit 2)
! exec fledge pulse
stderr 'usage'

# a subject that would escape the ledger directory is rejected, not
# sanitized, consistent with heartbeat/ledger read
! exec fledge pulse ../escape
stderr 'invalid'
! exec fledge pulse a/b
stderr 'invalid'

-- aged-not-stalled.json --
{"subject":"long-runner","kind":"status","timestamp":"2024-01-01T00:00:00Z","payload":{"note":"long haul","expect":"438000h","updated_at":"2024-01-01T00:00:00Z"}}
-- aged-stalled.json --
{"subject":"gone-quiet","kind":"status","timestamp":"2024-01-01T00:00:00Z","payload":{"note":"went quiet","expect":"5m","updated_at":"2024-01-01T00:00:00Z"}}
-- .fledge/.gitkeep --
