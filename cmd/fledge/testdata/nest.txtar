# fledge nest new: creates known concern docs, rejects unknown, --force, --json
exec git init -q .
exec git -c user.email=t@t commit --allow-empty -m init

# nest new creates a known doc in .fledge/nest/
exec fledge nest new architecture
stdout '.fledge/nest/architecture.md'
exists .fledge/nest/architecture.md
grep 'generated:' .fledge/nest/architecture.md
grep 'commit:' .fledge/nest/architecture.md
grep 'fledge_version:' .fledge/nest/architecture.md
grep '# Architecture' .fledge/nest/architecture.md

# unknown doc → exit 2 (usage error)
! exec fledge nest new bogus
stderr 'bogus'
! exists .fledge/nest/bogus.md

# existing file without --force → exit 1
! exec fledge nest new architecture
stderr 'architecture'

# existing file with --force → overwrites, exit 0
exec fledge nest new architecture --force
stdout '.fledge/nest/architecture.md'
exists .fledge/nest/architecture.md

# --json emits {"path": "..."}
exec fledge nest new modules --json
stdout '"path"'
stdout '.fledge/nest/modules.md'

# nest scout: missing --module → exit 2 (usage error)
! exec fledge nest scout
stderr 'module'

# nest scout: creates raw/<m>.md with scout-schema frontmatter and template body
exec fledge nest scout --module cli
stdout 'created .fledge/nest/raw/cli.md'
exists .fledge/nest/raw/cli.md
grep 'module: cli' .fledge/nest/raw/cli.md
grep 'authored:' .fledge/nest/raw/cli.md
grep 'agent: fledge-context-scout' .fledge/nest/raw/cli.md
grep 'fledge_version:' .fledge/nest/raw/cli.md
grep '# Module: cli' .fledge/nest/raw/cli.md

# nest scout: existing without --force → exit 1
! exec fledge nest scout --module cli
stderr 'cli'

# nest scout: existing with --force → overwrites, exit 0
exec fledge nest scout --module cli --force
stdout 'created .fledge/nest/raw/cli.md'
exists .fledge/nest/raw/cli.md

# nest scout: --json emits {"path": "..."}
exec fledge nest scout --module spec --json
stdout '"path"'
stdout '.fledge/nest/raw/spec.md'

# nest stamp: refreshes derived fields, preserves agent and body, drops unknown key
exec fledge nest stamp .fledge/nest/stale-doc.md
stdout 'stamped .fledge/nest/stale-doc.md'
grep 'generated:' .fledge/nest/stale-doc.md
grep 'commit:' .fledge/nest/stale-doc.md
grep 'agent: fledge-forager' .fledge/nest/stale-doc.md
grep 'fledge_version:' .fledge/nest/stale-doc.md
! grep 'stale_key:' .fledge/nest/stale-doc.md
grep 'Original body content' .fledge/nest/stale-doc.md

# nest stamp: --agent overrides stored agent field
exec fledge nest stamp .fledge/nest/stale-doc.md --agent fledge-new-agent
grep 'agent: fledge-new-agent' .fledge/nest/stale-doc.md
grep 'Original body content' .fledge/nest/stale-doc.md

# nest stamp: raw/*.md detects scout schema by path
exec fledge nest stamp .fledge/nest/raw/cli.md
stdout 'stamped .fledge/nest/raw/cli.md'
grep 'module: cli' .fledge/nest/raw/cli.md
grep 'authored:' .fledge/nest/raw/cli.md
! grep 'generated:' .fledge/nest/raw/cli.md

# nest stamp: --kind concern overrides path-based scout detection
exec fledge nest stamp .fledge/nest/raw/cli.md --kind concern
stdout 'stamped .fledge/nest/raw/cli.md'
grep 'generated:' .fledge/nest/raw/cli.md
! grep 'module:' .fledge/nest/raw/cli.md

# nest stamp: --kind invalid value → exit 2 (usage error)
! exec fledge nest stamp .fledge/nest/stale-doc.md --kind bogus
stderr 'bogus'

# nest stamp: path outside .fledge/nest/ → exit 2 (usage error)
! exec fledge nest stamp outsidepath.md
stderr 'outside'

# nest stamp: --json emits {"path": "..."}
exec fledge nest stamp .fledge/nest/architecture.md --json
stdout '"path"'
stdout '.fledge/nest/architecture.md'

# nest scaffold: clears all .md files and raw/, recreates nine concern docs
exec fledge nest scaffold
stdout 'created .fledge/nest/architecture.md'
exists .fledge/nest/architecture.md
exists .fledge/nest/modules.md
exists .fledge/nest/conventions.md
exists .fledge/nest/data-model.md
exists .fledge/nest/dependencies.md
exists .fledge/nest/entry-points.md
exists .fledge/nest/testing.md
exists .fledge/nest/domain.md
exists .fledge/nest/index.md
grep 'generated:' .fledge/nest/architecture.md
grep 'commit:' .fledge/nest/architecture.md
grep 'fledge_version:' .fledge/nest/architecture.md
! exists .fledge/nest/stale.md
! exists .fledge/nest/raw/x.md

# nest scaffold: --json emits {"created": [...]}
exec fledge nest scaffold --json
stdout '"created"'
stdout '.fledge/nest/architecture.md'

-- .fledge/.gitkeep --
-- .fledge/nest/stale.md --
this is a stale file that scaffold should remove
-- .fledge/nest/raw/x.md --
stray raw file that scaffold should remove
-- .fledge/nest/stale-doc.md --
---
generated: 2020-01-01T00:00:00Z
commit: oldsha
agent: fledge-forager
fledge_version: 0.0.1
stale_key: should-be-dropped
---

# Stale Document

Original body content.

