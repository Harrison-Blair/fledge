# fledge new: ID allocation, template instantiation, validation
exec git init -q .

exec fledge new req --title 'Deterministic CLI' --priority P0
stdout 'spec/requirements/REQ-001-deterministic-cli.md'
exists spec/requirements/REQ-001-deterministic-cli.md
grep 'status: draft' spec/requirements/REQ-001-deterministic-cli.md
grep 'priority: P0' spec/requirements/REQ-001-deterministic-cli.md
grep '# REQ-001: Deterministic CLI' spec/requirements/REQ-001-deterministic-cli.md

# a task against a draft requirement is refused without --force
! exec fledge new task --title 'First task' --req REQ-001
stderr 'draft'

exec fledge status REQ-001 approved
exec fledge new task --title 'First task' --req REQ-001
stdout 'spec/tasks/TASK-001-first-task.md'
grep 'status: ready' spec/tasks/TASK-001-first-task.md
grep 'depends_on: \[\]' spec/tasks/TASK-001-first-task.md

# dependent task starts blocked; oversight recorded
exec fledge new task --title 'Second' --req REQ-001 --depends-on TASK-001 --oversight merge
grep 'status: blocked' spec/tasks/TASK-002-second.md
grep 'depends_on: \[TASK-001\]' spec/tasks/TASK-002-second.md
grep 'oversight: merge' spec/tasks/TASK-002-second.md

# dangling dependency and unknown requirement are refused
! exec fledge new task --title 'Bad' --req REQ-001 --depends-on TASK-099
stderr 'TASK-099'
! exec fledge new task --title 'Bad' --req REQ-042
stderr 'REQ-042'

# invalid enums are usage errors
! exec fledge new req --title 'X' --priority P9
! exec fledge new task --title 'X' --req REQ-001 --oversight always

# json output and IDs allocate sequentially
exec fledge new req --title 'Colon: in title' --json
stdout '"id": "REQ-002"'

# everything fledge new writes passes fledge check (REQ-002 is draft with no tasks)
exec fledge check
stdout 'spec clean: 2 requirements, 2 tasks'

-- .fledge/scan-ignore --
