# fledge graph: waves, annotations, dot, cycle failure
exec git init -q .

exec fledge graph
stdout 'wave 1: TASK-001 \[done\]'
stdout 'wave 2: TASK-002'
stdout 'wave 3: TASK-003'

exec fledge graph --format dot
stdout 'digraph fledge'
stdout '"TASK-001" -> "TASK-002"'

exec fledge graph --json
stdout '"waves"'

! exec fledge graph --format nope
stderr 'unknown --format'

# a cycle makes graph fail with the path
cp cyc/TASK-004-c1.md spec/tasks/TASK-004-c1.md
cp cyc/TASK-005-c2.md spec/tasks/TASK-005-c2.md
! exec fledge graph
stderr 'dependency cycle: TASK-00'

