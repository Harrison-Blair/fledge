# fledge vee: waves, annotations, dot, cycle failure
exec git init -q .

exec fledge vee
stdout 'wave 1: FTHR-001 \[fledged\]'
stdout 'wave 2: FTHR-002'
stdout 'wave 3: FTHR-003'

exec fledge vee --format dot
stdout 'digraph fledge'
stdout '"FTHR-001" -> "FTHR-002"'

exec fledge vee --json
stdout '"waves"'

! exec fledge vee --format nope
stderr 'unknown --format'

# a cycle makes vee fail with the path
cp cyc/FTHR-004-c1.md pluma/feathers/FTHR-004-c1.md
cp cyc/FTHR-005-c2.md pluma/feathers/FTHR-005-c2.md
! exec fledge vee
stderr 'dependency cycle: FTHR-00'

