# fledge scan: module grouping, .fledgeignore filtering, output format
exec git init -q .

exec fledge scan
stdout '# fledge scan — commit none'
stdout 'module: <root> \(files: 1, bytes: 6\)'
stdout 'module: dir1 \(files: 2, bytes: 7\)'
stdout '  dir1/a.txt'
! stdout 'skip.log'
! stdout 'fledgeignore'

exec fledge scan --json
stdout '"commit": null'
stdout '"name": "dir1"'

-- .fledge/.gitkeep --
-- .fledgeignore --
*.log
.fledge/
.fledgeignore
-- README.md --
hello
-- dir1/a.txt --
aaaa
-- dir1/b.txt --
b
-- dir2/skip.log --
ignored
