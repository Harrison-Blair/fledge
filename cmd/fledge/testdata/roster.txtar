# fledge roster: assign/release/list subcommands wrapping internal/roster

exec git init -q .
exec git -c user.email=t@t commit --allow-empty -m init

# list with no assignments → empty JSON list (not null)
exec fledge roster --json
stdout '\[\]'

# --- overflow: exhaust all 18 base species, 19th assign gets a -2 suffix ---
exec fledge roster assign --feather F --json
exec fledge roster assign --feather F --json
exec fledge roster assign --feather F --json
exec fledge roster assign --feather F --json
exec fledge roster assign --feather F --json
exec fledge roster assign --feather F --json
exec fledge roster assign --feather F --json
exec fledge roster assign --feather F --json
exec fledge roster assign --feather F --json
exec fledge roster assign --feather F --json
exec fledge roster assign --feather F --json
exec fledge roster assign --feather F --json
exec fledge roster assign --feather F --json
exec fledge roster assign --feather F --json
exec fledge roster assign --feather F --json
exec fledge roster assign --feather F --json
exec fledge roster assign --feather F --json
# 18th assign uses the last base species
exec fledge roster assign --feather F --json
stdout 'northernrockhopper'
# 19th assign overflows to a numeric-suffixed species
exec fledge roster assign --feather F --json
stdout 'adelie-2'

# reset state for the pair/release scenario
rm .fledge/roster/roster.json

# --- assign a pair → two distinct names sharing species adelie ---
exec fledge roster assign --feather FTHR-001 --pair --json
stdout 'fledge-brooder-adelie'
stdout 'fledge-skua-adelie'

# a second assign for a different feather → next unused species emperor
exec fledge roster assign --feather FTHR-002 --json
stdout 'emperor'

# list (--json) shows both entries with their feathers
exec fledge roster --json
stdout 'adelie'
stdout 'emperor'
stdout 'FTHR-001'
stdout 'FTHR-002'

# list (text, no --json) shows name→feather assignments
exec fledge roster
stdout 'adelie'
stdout 'FTHR-001'

# release one member of the adelie pair → species not yet freed, still listed
exec fledge roster release fledge-brooder-adelie
exec fledge roster --json
stdout 'adelie'

# release the second member → adelie removed from the list
exec fledge roster release fledge-skua-adelie
exec fledge roster --json
! stdout 'adelie'

# a subsequent assign reuses the now-freed adelie species
exec fledge roster assign --feather FTHR-003 --json
stdout 'adelie'

# releasing an unknown name → domain failure (exit 1)
! exec fledge roster release nosuch
stderr 'nosuch'

# --- solo planning-phase allocation via --for (no feather exists yet) ---

# reset state
rm .fledge/roster/roster.json

# --for reserves a species and records the purpose in the feather column
exec fledge roster assign --for foraging --json
stdout 'adelie'
exec fledge roster --json
stdout 'foraging'

# neither --feather nor --for → usage error (exit 2)
! exec fledge roster assign
stderr 'one of --feather or --for is required'

# both --feather and --for → usage error (exit 2)
! exec fledge roster assign --feather FTHR-001 --for planning
stderr 'mutually exclusive'

# --pair is feather-bound; --for is solo-only → usage error (exit 2)
! exec fledge roster assign --for planning --pair
stderr '--pair requires --feather'

# releasing by full worker name strips the forager/incubator role prefix
exec fledge roster release fledge-forager-adelie
exec fledge roster --json
! stdout 'adelie'
exec fledge roster assign --for planning --json
stdout 'adelie'
exec fledge roster release fledge-incubator-adelie
exec fledge roster --json
! stdout 'adelie'

# unknown subcommand → usage error (exit 2)
! exec fledge roster bogus
stderr 'bogus'

-- .fledge/.gitkeep --
