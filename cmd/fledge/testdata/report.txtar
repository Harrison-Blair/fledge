# fledge colony: status counts, per-REQ completion, orphan feathers, --json, empty repo, usage/env errors

# outside a fledge repo: not yet a git repository
! exec fledge colony
stderr 'not inside a git repository'

exec git init -q .

# git repo exists, but .fledge/ is missing
! exec fledge colony
stderr '\.fledge/ not found'

mkdir .fledge

# empty repo: .fledge/ present, no specs at all -> valid zero colony, exit 0
exec fledge colony
stdout 'Feathers: 0 total \(egg: 0, pipping: 0, hatching: 0, fledged: 0\)'
stdout '\(none\)'

exec fledge colony --json
stdout '"total": 0'
stdout '"plumages": \[\]'
stdout '"orphans": \[\]'

# usage error: unknown flag
! exec fledge colony --bogus
stderr 'flag provided but not defined'

# populate a repo with two plumages, mixed-status feathers, and an orphan feather
mkdir -p pluma/plumage
mkdir -p pluma/feathers
cp req1.md pluma/plumage/PLM-001-first-requirement.md
cp req2.md pluma/plumage/PLM-002-second-requirement.md
cp task1.md pluma/feathers/FTHR-001-first.md
cp task2.md pluma/feathers/FTHR-002-second.md
cp task3.md pluma/feathers/FTHR-003-third.md
cp task4.md pluma/feathers/FTHR-004-orphan.md

exec fledge colony
stdout 'Feathers: 4 total \(egg: 1, pipping: 2, hatching: 0, fledged: 1\)'
stdout 'PLM-001  First requirement  hatched  1/2 fledged'
stdout 'PLM-002  Second requirement  hatched  0/1 fledged'
stdout 'FTHR-004  Orphan task  \(plumage: PLM-999\)'

exec fledge colony --json
stdout '"egg": 1'
stdout '"pipping": 2'
stdout '"hatching": 0'
stdout '"fledged": 1'
stdout '"total": 4'
stdout '"id": "PLM-001"'
stdout '"id": "PLM-002"'
stdout '"id": "FTHR-004"'
stdout '"plumage": "PLM-999"'

# egg detail: a dep chain with one fledged dep, one unfledged dep, and one
# dangling dep -> the egg feather line names exactly its unmet dep IDs (FC-4)
cp task101.md pluma/feathers/FTHR-101-done-dep.md
cp task102.md pluma/feathers/FTHR-102-notdone-dep.md
cp task103.md pluma/feathers/FTHR-103-blocked-detail.md

exec fledge colony
stdout 'FTHR-103  Blocked detail task  \(unmet: FTHR-102, FTHR-999\)'

# active broods: brood a feather, then the colony broods section shows feather + owner (FC-5)
exec fledge brood FTHR-102 --owner alice
exec fledge colony
stdout 'Broods:'
stdout '  FTHR-102  alice'

# degraded data: a file with broken frontmatter plus dangling refs (FTHR-004's
# dangling plumage, FTHR-103's dangling depends_on) -> colony still exits 0,
# names the parse failure and dangling refs, and still summarizes parsed specs (FC-7)
cp badfrontmatter.md pluma/feathers/FTHR-105-broken.md

exec fledge colony
stdout 'Feathers: 7 total \(egg: 2, pipping: 2, hatching: 1, fledged: 2\)'
stdout 'Issues:'
stdout 'pluma/feathers/FTHR-105-broken\.md: unterminated frontmatter'
stdout 'FTHR-004 plumage PLM-999 not found'
stdout 'FTHR-103 depends_on FTHR-999 not found'

# --json: egg, broods, and issues keys all present in the same document (FC-6)
exec fledge colony --json
stdout '"egg": \['
stdout '"id": "FTHR-103"'
stdout '"unmet": \['
stdout '"broods": \['
stdout '"feather": "FTHR-102"'
stdout '"owner": "alice"'
stdout '"issues": {'
stdout '"parse_errors": \['
stdout '"dangling_refs": \['

