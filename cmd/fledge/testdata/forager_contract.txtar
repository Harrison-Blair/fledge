# forager wait-contract: scaffolded planning.md and incubator.md must
# state the ledger-driven done signal (FTHR-075: `fledge await` the forager's
# `status` record, not its final message or a lifecycle notification) and
# must not leak forager-internal pipeline-stage or stall-failure-mode
# vocabulary. See PLM-020 / FTHR-040, superseded in part by PLM-030 / FTHR-075.
exec git init -q .

exec fledge init

# forbidden: pipeline-stage / failure-mode leakage
! grep 'step-4→step-5' .fledge/skills/fledge-orchestrate/planning.md
! grep 'synthesis boundary' .fledge/skills/fledge-orchestrate/planning.md
! grep 'half-filled nest' .fledge/skills/fledge-orchestrate/planning.md
! grep 'mid-pipeline' .fledge/skills/fledge-orchestrate/planning.md
! grep 'see `foraging.md` for what that expected intermediate state looks like' .fledge/skills/fledge-orchestrate/planning.md

! grep 'step-4→step-5' .fledge/skills/fledge-orchestrate/incubator.md
! grep 'synthesis boundary' .fledge/skills/fledge-orchestrate/incubator.md
! grep 'half-filled nest' .fledge/skills/fledge-orchestrate/incubator.md
! grep 'mid-pipeline' .fledge/skills/fledge-orchestrate/incubator.md
! grep 'see `foraging.md` for what that expected intermediate state looks like' .fledge/skills/fledge-orchestrate/incubator.md

# required: ledger-driven done signal present in both files (FTHR-075
# replaced the old final-message-only framing with an await'd status record)
grep 'the done signal rather than its final message or any idle/lifecycle notification' .fledge/skills/fledge-orchestrate/planning.md
grep 'never by comparing timestamps yourself' .fledge/skills/fledge-orchestrate/planning.md

grep 'the done signal rather than its final message or any idle/lifecycle notification' .fledge/skills/fledge-orchestrate/incubator.md
grep 'never to be trusted over the ledger' .fledge/skills/fledge-orchestrate/incubator.md

# forager force-terminate backstop (FTHR-041 AC-3, tightened by FTHR-056): both
# the Forager Lifecycle section and the Commissioner's "verify and release" step
# still document it, but now name the actual kill-primitive holder (the
# orchestrator) instead of the abstract "commissioner (incubator or
# orchestrator)" disjunction, which the incubator cannot perform on Claude Code.
grep 'to force-terminate you if you do not exit promptly' .fledge/skills/fledge-orchestrate/foraging.md
grep 'force-terminates the forager if it does not exit promptly' .fledge/skills/fledge-orchestrate/foraging.md
grep -count=2 'party holding the .spawn-worker./kill primitive' .fledge/skills/fledge-orchestrate/foraging.md
! grep 'the incubator or the orchestrator' .fledge/skills/fledge-orchestrate/foraging.md
! grep 'expect it to force-terminate you' .fledge/skills/fledge-orchestrate/foraging.md
! grep 'worker that commissioned it' .fledge/skills/fledge-orchestrate/foraging.md

# exact-computation-for-counts rule (FTHR-044): any count reported in a scout
# report or synthesized doc must come from an exact computation run at write
# time, never estimated by eye
grep 'exact computation run at write time' .fledge/skills/fledge-orchestrate/foraging.md
