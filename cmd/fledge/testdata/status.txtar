# fledge status: reads and legal transitions
exec git init -q .

exec fledge status FTHR-001
stdout 'FTHR-001: pipping'

# skipping hatching is illegal without --force
! exec fledge status FTHR-001 fledged
stderr 'illegal transition'

exec fledge status FTHR-001 hatching
exec fledge status FTHR-001 fledged
grep 'status: fledged' .fledge/pluma/feathers/FTHR-001-first.md

# invalid enum is refused even with --force
! exec fledge status FTHR-002 nonsense --force
stderr 'not one of'

# --force bypasses transition legality
exec fledge status FTHR-002 fledged --force
grep 'status: fledged' .fledge/pluma/feathers/FTHR-002-second.md

# plumage lifecycle
exec fledge status PLM-001
stdout 'PLM-001: egg'
exec fledge status PLM-001 hatched
exec fledge status PLM-001 fledged
grep 'status: fledged' .fledge/pluma/plumage/PLM-001-a.md

# unknown ID
! exec fledge status FTHR-099
stderr 'not found'

# plumage fledged is gated on checked acceptance criteria
! exec fledge status PLM-002 fledged
stderr 'AC-1'
grep 'status: hatched' .fledge/pluma/plumage/PLM-002-gated.md
exec fledge criteria check PLM-002 1
exec fledge status PLM-002 fledged
grep 'status: fledged' .fledge/pluma/plumage/PLM-002-gated.md

# body is preserved byte-for-byte through rewrites
grep 'sentinel body line' .fledge/pluma/feathers/FTHR-001-first.md

# --json emits {id, from, to} for a driven transition
exec fledge status FTHR-002 pipping --force
exec fledge status FTHR-002 hatching --json
stdout '"id": "FTHR-002"'
stdout '"from": "pipping"'
stdout '"to": "hatching"'

-- .fledge/.gitkeep --
-- .fledge/pluma/plumage/PLM-001-a.md --
