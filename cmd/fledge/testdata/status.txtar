# fledge status: reads and legal transitions
exec git init -q .

exec fledge status TASK-001
stdout 'TASK-001: ready'

# skipping in-progress is illegal without --force
! exec fledge status TASK-001 done
stderr 'illegal transition'

exec fledge status TASK-001 in-progress
exec fledge status TASK-001 done
grep 'status: done' spec/tasks/TASK-001-first.md

# invalid enum is refused even with --force
! exec fledge status TASK-002 nonsense --force
stderr 'not one of'

# --force bypasses transition legality
exec fledge status TASK-002 done --force
grep 'status: done' spec/tasks/TASK-002-second.md

# requirement lifecycle
exec fledge status REQ-001
stdout 'REQ-001: draft'
exec fledge status REQ-001 approved
exec fledge status REQ-001 done
grep 'status: done' spec/requirements/REQ-001-a.md

# unknown ID
! exec fledge status TASK-099
stderr 'not found'

# requirement done is gated on checked acceptance criteria
! exec fledge status REQ-002 done
stderr 'AC-1'
grep 'status: approved' spec/requirements/REQ-002-gated.md
exec fledge criteria check REQ-002 1
exec fledge status REQ-002 done
grep 'status: done' spec/requirements/REQ-002-gated.md

# body is preserved byte-for-byte through rewrites
grep 'sentinel body line' spec/tasks/TASK-001-first.md

-- .fledge/scan-ignore --
-- spec/requirements/REQ-001-a.md --
