# fledge verdict: write a pass/fail verdict record to the ledger
exec git init -q .

# happy path: writes one verdict record for the named subject
exec fledge verdict some-review --result pass --note 'looks good'
exists .fledge/ledger/some-review.verdict.json
stdout 'some-review'

# --json emits the written record: subject, kind, result, note
exec fledge verdict some-review --result fail --note 'needs work' --json
stdout '"subject": "some-review"'
stdout '"kind": "verdict"'
stdout '"result": "fail"'
stdout '"note": "needs work"'
stdout '"timestamp": "'

# --note is optional
exec fledge verdict some-review --result pass --json
stdout '"note": ""'

# malformed input: an invalid --result value is a usage error (exit 2)
! exec fledge verdict some-review --result maybe
stderr 'usage'

# malformed input: missing <subject> is a usage error (exit 2)
! exec fledge verdict --result pass
stderr 'usage'

-- .fledge/.gitkeep --
