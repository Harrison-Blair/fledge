# fledge init: planning.md delegation branch and foraging.md empty-nest note
exec git init -q .

exec fledge init
exists .fledge/skills/fledge-orchestrate/planning.md
exists .fledge/skills/fledge-orchestrate/foraging.md

# delegation markers: pin the delegated-planner branch and the create-then-gate
# invariant in planning.md
grep 'Spawn a .fledge-incubator. worker' .fledge/skills/fledge-orchestrate/planning.md
grep 'until its gate returns .Accept.' .fledge/skills/fledge-orchestrate/planning.md

# empty-nest marker: pins the expected-intermediate-state clarification in foraging.md
grep 'expected intermediate after scaffolding' .fledge/skills/fledge-orchestrate/foraging.md

# force-terminate backstop (FTHR-041 AC-4): planning.md's incubator-release
# (§0) and forager-release (§2) steps both reference it
grep -count=1 'force-terminating it if it does not exit promptly' .fledge/skills/fledge-orchestrate/planning.md
# the forager backstop names the party holding the kill primitive (the
# incubator holds none): the orchestrator force-terminates when delegated
grep 'kill primitive .the orchestrator, when planning is delegated. force-terminates it' .fledge/skills/fledge-orchestrate/planning.md
