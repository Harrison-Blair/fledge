# fledge criteria: list, preen, uncheck acceptance-criteria boxes
exec git init -q .

# list (human)
exec fledge criteria FTHR-001
stdout '\[ \] AC-1: tests observed failing then passing'
stdout '\[x\] AC-2: already verified'
stdout '1/3 checked'

# list (json)
exec fledge criteria FTHR-001 --json
stdout '"id": "FTHR-001"'
stdout '"total": 3'
stdout '"checked": 1'
stdout '"label": "AC-1"'

# preen by bare number
exec fledge criteria check FTHR-001 1
stdout 'FTHR-001: AC-1 checked'
grep '\- \[x\] AC-1: tests observed failing then passing' .fledge/pluma/feathers/FTHR-001-first.md

# re-check is idempotent
exec fledge criteria check FTHR-001 1 --json
stdout '"changed": false'

# preen by AC label
exec fledge criteria check FTHR-001 AC-3
grep '\- \[x\] AC-3: third' .fledge/pluma/feathers/FTHR-001-first.md
exec fledge criteria FTHR-001
stdout '3/3 checked'

# uncheck
exec fledge criteria uncheck FTHR-001 3
grep '\- \[ \] AC-3: third' .fledge/pluma/feathers/FTHR-001-first.md

# works on plumages too
exec fledge criteria PLM-001
stdout '\[ \] AC-1: req criterion'
exec fledge criteria check PLM-001 1
grep '\- \[x\] AC-1: req criterion' .fledge/pluma/plumage/PLM-001-a.md

# body preserved byte-for-byte apart from the box
grep 'sentinel body line' .fledge/pluma/feathers/FTHR-001-first.md

# unknown ID
! exec fledge criteria FTHR-099
stderr 'not found'

# unknown criterion number
! exec fledge criteria check FTHR-001 9
stderr 'AC-9 not found'

# spec without parseable checkboxes
! exec fledge criteria check FTHR-002 1
stderr 'no acceptance-criteria checkboxes'

# usage errors
! exec fledge criteria
stderr 'usage'
! exec fledge criteria check FTHR-001
stderr 'usage'
! exec fledge criteria check FTHR-001 notanumber
stderr 'usage'

-- .fledge/.gitkeep --
-- .fledge/pluma/plumage/PLM-001-a.md --
---
id: PLM-001
title: A requirement
status: hatched
priority: P1
authored: 2026-07-06T12:00:00Z
agent: t
fledge_version: 0.1.0
---
## Context
x
## Functional Criteria
1. FC-1: prose stays numbered
## Acceptance Criteria
- [ ] AC-1: req criterion
