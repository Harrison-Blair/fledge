# fledge criteria: list, check, uncheck acceptance-criteria boxes
exec git init -q .

# list (human)
exec fledge criteria TASK-001
stdout '\[ \] AC-1: tests observed failing then passing'
stdout '\[x\] AC-2: already verified'
stdout '1/3 checked'

# list (json)
exec fledge criteria TASK-001 --json
stdout '"id": "TASK-001"'
stdout '"total": 3'
stdout '"checked": 1'
stdout '"label": "AC-1"'

# check by bare number
exec fledge criteria check TASK-001 1
stdout 'TASK-001: AC-1 checked'
grep '\- \[x\] AC-1: tests observed failing then passing' spec/tasks/TASK-001-first.md

# re-check is idempotent
exec fledge criteria check TASK-001 1 --json
stdout '"changed": false'

# check by AC label
exec fledge criteria check TASK-001 AC-3
grep '\- \[x\] AC-3: third' spec/tasks/TASK-001-first.md
exec fledge criteria TASK-001
stdout '3/3 checked'

# uncheck
exec fledge criteria uncheck TASK-001 3
grep '\- \[ \] AC-3: third' spec/tasks/TASK-001-first.md

# works on requirements too
exec fledge criteria REQ-001
stdout '\[ \] AC-1: req criterion'
exec fledge criteria check REQ-001 1
grep '\- \[x\] AC-1: req criterion' spec/requirements/REQ-001-a.md

# body preserved byte-for-byte apart from the box
grep 'sentinel body line' spec/tasks/TASK-001-first.md

# unknown ID
! exec fledge criteria TASK-099
stderr 'not found'

# unknown criterion number
! exec fledge criteria check TASK-001 9
stderr 'AC-9 not found'

# spec without parseable checkboxes
! exec fledge criteria check TASK-002 1
stderr 'no acceptance-criteria checkboxes'

# usage errors
! exec fledge criteria
stderr 'usage'
! exec fledge criteria check TASK-001
stderr 'usage'
! exec fledge criteria check TASK-001 notanumber
stderr 'usage'

-- .fledge/scan-ignore --
-- spec/requirements/REQ-001-a.md --
---
id: REQ-001
title: A requirement
status: approved
priority: P1
authored: 2026-07-06T12:00:00Z
agent: t
fledge_version: 0.1.0
---
## Context
x
## Functional Criteria
1. FC-1: prose stays numbered
## Acceptance Criteria
- [ ] AC-1: req criterion
