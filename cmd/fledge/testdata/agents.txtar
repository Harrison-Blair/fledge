# fledge agents: adapter inventory with derived tier and scaffolded status
exec git init -q .

exec fledge agents
stdout 'agent adapters \(tier derived from primitive coverage\)'
stdout 'claude\ttier C\tdetector \.claude/\tnot scaffolded'
stdout 'codex\ttier A\tdetector \.codex/\tnot scaffolded'
stdout 'pi\ttier A\tdetector \.pi/\tnot scaffolded'

# scaffolding an adapter flips its status
exec fledge init --agent pi
exec fledge agents
stdout 'pi\ttier A\tdetector \.pi/\tscaffolded$'
stdout 'claude\ttier C\tdetector \.claude/\tnot scaffolded'

exec fledge agents --json
stdout '"name": "pi"'
stdout '"scaffolded": true'
stdout '"name": "claude"'
stdout '"tier": "C"'
